{"ast":null,"code":"export default {\n  name: 'FormComponent',\n  data() {\n    return {\n      x: '',\n      y: '',\n      r: '',\n      errorMessage: ''\n    };\n  },\n  methods: {\n    handleClick() {\n      if (!this.validateFields()) return;\n      this.$emit('submit-data', {\n        x: this.x,\n        y: this.y,\n        r: this.r\n      });\n      this.x = '';\n      this.y = '';\n      this.r = '';\n      this.errorMessage = '';\n    },\n    validateFields() {\n      const xNum = parseFloat(this.x);\n      const yNum = parseFloat(this.y);\n      const rNum = parseFloat(this.r);\n      console.log(xNum, yNum, rNum);\n      if (isNaN(xNum) || xNum < -5 || xNum > 3) {\n        this.errorMessage = 'X должен быть числом от -5 до 3.';\n        return false;\n      }\n      if (isNaN(yNum) || yNum < -3 || yNum > 3) {\n        this.errorMessage = 'Y должен быть числом от -3 до 3.';\n        return false;\n      }\n      if (isNaN(rNum) || rNum < 0 || rNum > 3) {\n        this.errorMessage = 'R должен быть числом от 0 до 3.';\n        return false;\n      }\n      return true;\n    },\n    updateGraph() {\n      if (!(this.r >= 0 && this.r <= 3)) {\n        this.errorMessage = 'R должен быть числом от 0 до 3.';\n        return;\n      }\n      this.errorMessage = '';\n      this.$emit('update-graph', this.r);\n    }\n  }\n};","map":{"version":3,"names":["name","data","x","y","r","errorMessage","methods","handleClick","validateFields","$emit","xNum","parseFloat","yNum","rNum","console","log","isNaN","updateGraph"],"sources":["/Users/chousik/IdeaProjects/web4_hipioplea/lab4front/src/components/subMainPage/inputData.vue"],"sourcesContent":["<template>\n    <form class=\"main\" @submit.prevent=\"handleClick\">\n      <h2>Введите данные</h2>\n      <div class=\"form-group\">\n        <label for=\"x\" class=\"label\">X</label>\n        <input\n            id=\"x\"\n            type=\"text\"\n            class=\"textInput\"\n            v-model=\"x\"\n            placeholder=\"-5 ... 3\"\n            required\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"y\" class=\"label\">Y</label>\n        <input\n            id=\"y\"\n            type=\"text\"\n            class=\"textInput\"\n            v-model=\"y\"\n            placeholder=\"-3 ... 3\"\n            required\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"r\" class=\"label\">R</label>\n        <input\n            id=\"r\"\n            type=\"text\"\n            class=\"textInput\"\n            v-model=\"r\"\n            placeholder=\"0 ... 3\"\n            required\n            @input=\"updateGraph\"\n        />\n      </div>\n      <p v-if=\"errorMessage\" class=\"error\">{{ errorMessage }}</p>\n      <button type=\"submit\" class=\"btn\">Отправить</button>\n    </form>\n</template>\n\n<script>\nexport default {\n  name: 'FormComponent',\n  data() {\n    return {\n      x: '',\n      y: '',\n      r: '',\n      errorMessage: ''\n    };\n  },\n  methods: {\n    handleClick() {\n      if (!this.validateFields()) return;\n\n      this.$emit('submit-data', {\n        x: this.x,\n        y: this.y,\n        r: this.r\n      });\n\n      this.x = '';\n      this.y = '';\n      this.r = '';\n      this.errorMessage = '';\n    },\n\n    validateFields() {\n      const xNum = parseFloat(this.x);\n      const yNum = parseFloat(this.y);\n      const rNum = parseFloat(this.r);\n      console.log(xNum, yNum, rNum);\n      if (isNaN(xNum) || xNum < -5 || xNum > 3) {\n        this.errorMessage = 'X должен быть числом от -5 до 3.';\n        return false;\n      }\n\n      if (isNaN(yNum) || yNum < -3 || yNum > 3) {\n        this.errorMessage = 'Y должен быть числом от -3 до 3.';\n        return false;\n      }\n\n      if (isNaN(rNum) || rNum < 0 || rNum > 3) {\n        this.errorMessage = 'R должен быть числом от 0 до 3.';\n        return false;\n      }\n\n      return true;\n    },\n\n    updateGraph() {\n      if (!(this.r >= 0 && this.r <= 3)) {\n        this.errorMessage = 'R должен быть числом от 0 до 3.'\n        return;\n      }\n      this.errorMessage = '';\n      this.$emit('update-graph', this.r);\n    }\n  }\n};\n</script>\n\n<style scoped>\n\n.main {\n  display: inline-grid;\n  padding: 10px 10px;\n  border-radius: 16px;\n  background: #ecf0f3;\n  box-shadow: 4px 4px 4px 0 #d1d9e6 inset,\n  -4px -4px 4px 0 #d1d9e6 inset;\n  grid-area: main;\n  font-style: oblique;\n  place-items: center;\n  margin: auto 50px;\n  gap: 10px;\n}\n\n.form-group {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 10px;\n  width: 100%;\n}\n\n.textInput {\n  font-size: 16px;\n  border-radius: 8px;\n  line-height: 1.5;\n  padding: 5px 10px;\n  transition: box-shadow 100ms ease-in, border 100ms ease-in, background-color 100ms ease-in;\n  border: 2px solid #dee1e2;\n  color: rgb(53, 53, 87);\n  background: #dee1e2;\n  display: block;\n  height: 36px;\n  width: 100%;\n  box-sizing: border-box;\n  max-width: 80%;\n}\n\n.textInput:hover {\n  border-color: #ccc;\n}\n\n.label {\n  margin-right: 10px;\n  font-size: 16px;\n  color: #394a56;\n}\n\n.btn {\n  display: block;\n  margin: 20px auto;\n  padding: 10px 20px;\n  background: #e2e8ed;\n  border: none;\n  border-radius: 10px;\n  box-shadow: 0 5px 0 #c6cfdd;\n  font-size: 16px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.btn:hover {\n  background: #bec5d3;\n  box-shadow: none;\n  position: relative;\n  top: 5px;\n}\n.error {\n  color: red;\n  margin-top: 10px;\n  font-size: 14px;\n}\n</style>\n"],"mappings":"AA6CA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,CAAC,EAAE,EAAE;MACLC,CAAC,EAAE,EAAE;MACLC,CAAC,EAAE,EAAE;MACLC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAACC,cAAc,CAAC,CAAC,EAAE;MAE5B,IAAI,CAACC,KAAK,CAAC,aAAa,EAAE;QACxBP,CAAC,EAAE,IAAI,CAACA,CAAC;QACTC,CAAC,EAAE,IAAI,CAACA,CAAC;QACTC,CAAC,EAAE,IAAI,CAACA;MACV,CAAC,CAAC;