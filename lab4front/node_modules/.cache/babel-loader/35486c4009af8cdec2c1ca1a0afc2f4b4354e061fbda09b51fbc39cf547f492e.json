{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { useAuthStore } from '@/auth'; // Импортируем хранилище\nimport loginform from '../components/subStartPage/LoginForm.vue';\nimport { useRouter } from 'vue-router';\nimport { watch } from 'vue';\nexport default {\n  name: 'StartPage',\n  components: {\n    loginform\n  },\n  setup() {\n    const authStore = useAuthStore(); // Получаем доступ к хранилищу\n    const router = useRouter();\n\n    // Следим за состоянием пользователя и переходим на главную страницу после успешного входа\n    watch(authStore.user, newUser => {\n      if (newUser) {\n        router.push('/main');\n      }\n    });\n    return {\n      user: authStore.user,\n      error: authStore.error,\n      login: authStore.login\n    };\n  }\n};","map":{"version":3,"names":["useAuthStore","loginform","useRouter","watch","name","components","setup","authStore","router","user","newUser","push","error","login"],"sources":["/Users/chousik/IdeaProjects/web4_hipioplea/lab4front/src/components/startPage.vue"],"sourcesContent":["<template>\n  <div class=\"home-page\">\n    <div class=\"header\">\n      <h1>Черемисова Мария</h1>\n      <h3>P3210</h3>\n      <h3>409829</h3>\n    </div>\n    <main class=\"main-content\">\n      <loginform @login=\"login\"/>\n      <p v-if=\"error\" class=\"error\">{{ error }}</p>\n    </main>\n  </div>\n</template>\n\n<script>\nimport {useAuthStore} from '@/auth';  // Импортируем хранилище\nimport loginform from '../components/subStartPage/LoginForm.vue';\nimport {useRouter} from 'vue-router';\nimport {watch} from 'vue';\n\nexport default {\n  name: 'StartPage',\n  components: {\n    loginform,\n  },\n  setup() {\n    const authStore = useAuthStore();  // Получаем доступ к хранилищу\n    const router = useRouter();\n\n    // Следим за состоянием пользователя и переходим на главную страницу после успешного входа\n    watch(authStore.user, (newUser) => {\n      if (newUser) {\n        router.push('/main');\n      }\n    });\n\n    return {user: authStore.user, error: authStore.error, login: authStore.login};\n  },\n};\n</script>\n\n<style scoped>\n.home-page {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-start;\n  min-height: 100vh;\n  background: #ecf0f3;\n  color: #394a56;\n}\n\n.header {\n  padding: 20px;\n  text-align: center;\n}\n\n.main-content {\n  max-width: 500px;\n  padding: 20px;\n  border-radius: 10px;\n  margin-top: 20px;\n  box-sizing: border-box;\n  overflow-y: auto;\n  margin-bottom: 20px;\n}\n\n.error {\n  color: red;\n  margin-top: 10px;\n  font-size: 14px;\n}\n</style>\n"],"mappings":";AAeA,SAAQA,YAAY,QAAO,QAAQ,EAAG;AACtC,OAAOC,SAAQ,MAAO,0CAA0C;AAChE,SAAQC,SAAS,QAAO,YAAY;AACpC,SAAQC,KAAK,QAAO,KAAK;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVJ;EACF,CAAC;EACDK,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIP,YAAY,CAAC,CAAC,EAAG;IACnC,MAAMQ,MAAK,GAAIN,SAAS,CAAC,CAAC;;IAE1B;IACAC,KAAK,CAACI,SAAS,CAACE,IAAI,EAAGC,OAAO,IAAK;MACjC,IAAIA,OAAO,EAAE;QACXF,MAAM,CAACG,IAAI,CAAC,OAAO,CAAC;MACtB;IACF,CAAC,CAAC;IAEF,OAAO;MAACF,IAAI,EAAEF,SAAS,CAACE,IAAI;MAAEG,KAAK,EAAEL,SAAS,CAACK,KAAK;MAAEC,KAAK,EAAEN,SAAS,CAACM;IAAK,CAAC;EAC/E;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}